# ------------------------------------------------------------------------------
# Evolet HRM — settings for the company's server (shared hosting, cPanel).
#
# Copy this file to the server as `.env`, next to `artisan`, and fill in every
# value marked CHANGE. The step-by-step guide is docs/deploy-cpanel.md.
#
# Rules of the file: a value with a space or a `#` in it goes in "double quotes";
# after any change run `php artisan config:cache`, or the old values stay in use.
# Never commit the filled-in file and never put it inside public_html.
# ------------------------------------------------------------------------------

APP_NAME="Evolet HRM"

# "production" switches the demo seeder off, forbids commands that wipe the
# database (migrate:fresh and the like) and turns the friendly error pages on.
APP_ENV=production

# Leave empty here and run `php artisan key:generate` once on the server.
# Generate it ONCE: sessions and the letters waiting in the queue are encrypted
# with it, so a new key signs everybody out and makes queued letters unreadable.
APP_KEY=

# Must stay false. With true, any error shows passwords from this file to
# whoever happens to see the page.
APP_DEBUG=false

# Dates and the schedule (cron tasks) are read in this timezone, not the server's.
APP_TIMEZONE=Asia/Dushanbe

# CHANGE: the address people type, with https:// and without a trailing slash.
# Links in letters and the addresses of photographs are built from it.
APP_URL=https://hrm.example.tj

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Log ----------------------------------------------------------------------
# One file a day in storage/logs, kept for two weeks, so the log cannot fill the
# disk quota. "warning" leaves out routine chatter; errors are still written.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (cPanel → MySQL Databases) ----------------------------------------
# CHANGE: cPanel prefixes both names with the account name: user_hrm, user_hrmuser.
# The host is almost always localhost (a socket, faster than 127.0.0.1).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_hrm
DB_USERNAME=cpaneluser_hrm
DB_PASSWORD="CHANGE-ME"

# --- Sessions -------------------------------------------------------------------
# Kept in the database. 120 = minutes without activity before signing in again.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The cookie travels over https only. Needs a working SSL certificate: over plain
# http nobody would be able to sign in (the form would keep answering "419").
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Cache and queue --------------------------------------------------------------
# Both in the database: shared hosting has no Redis and lets nothing stay running.
# The queue is emptied once a minute by cron (routes/console.php), so a letter
# leaves within a minute of being asked for.
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Photographs ------------------------------------------------------------------
# Nothing to set on a new installation: photographs are kept in
# storage/app/photos, which the web server cannot reach, and the application
# hands each one out only to somebody who may see the card it belongs to.
#
# This names the folder inside the web root where photographs were written back
# when they were static files, and is only still read so that
# `php artisan hrm:photos-private` can find them there and move them. No
# trailing slash. Delete the line once that command has reported success; see
# docs/deploy-cpanel.md, section 7.
# PUBLIC_DISK_ROOT=/home/cpaneluser/public_html/storage

# --- Mail (cPanel → Email Accounts → Connect Devices) -------------------------------
# The mailbox hrm@evolet.tj on the hosting. CHANGE only the password.
#   port 465 — SSL from the first byte (the usual choice on cPanel)
#   port 587 — STARTTLS
# MAIL_ENCRYPTION stays "tls" for both; the port decides which of the two it is.
# MAIL_FROM_ADDRESS must be the same mailbox as MAIL_USERNAME — most hosts refuse
# to send "from" an address the login does not own, and the letter is lost.
MAIL_MAILER=smtp
MAIL_HOST=mail.evolet.tj
MAIL_PORT=465
MAIL_USERNAME=hrm@evolet.tj
MAIL_PASSWORD="CHANGE-ME"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hrm@evolet.tj"
MAIL_FROM_NAME="${APP_NAME}"

# --- Things that must stay off on the server -----------------------------------------
# There is no Node on shared hosting to render pages on the server side.
INERTIA_SSR_ENABLED=false
# The debug toolbar is a development package and is not installed with
# `composer install --no-dev`; this keeps it off even if it got uploaded.
DEBUGBAR_ENABLED=false

# Shown in the browser tab. Read when the front end is BUILT (`npm run build` on
# the developer's machine), not on the server — changing it here does nothing.
VITE_APP_NAME="${APP_NAME}"
